<Window x:Class="NetStability.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:charts="clr-namespace:NetStability.App.Controls"
        Title="NetStability — Diagnóstico de conexão" Height="850" Width="1320"
        MinHeight="720" MinWidth="1080" Background="{StaticResource WindowBackground}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="27" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,7,0,0" />
        </Style>
        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="Background" Value="#25354B" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="NETSTABILITY" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold" />
                <TextBlock Text="Estabilidade da conexão, com evidências" FontSize="25" FontWeight="SemiBold" Margin="0,3,0,0" />
                <TextBlock x:Name="AdapterSummaryText" Text="Lendo adaptador e rota..." Foreground="{StaticResource SecondaryText}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="DiagnoseButton" Content="Executar diagnóstico" Click="DiagnoseButton_Click" />
                <Button x:Name="MonitorButton" Content="Iniciar monitoramento" Style="{StaticResource SecondaryButton}" Click="MonitorButton_Click" />
                <Button x:Name="OptimizeButton" Content="Otimizar com justificativa" Click="OptimizeButton_Click" />
                <Button x:Name="RestoreButton" Content="Restaurar" Style="{StaticResource SecondaryButton}" Click="RestoreButton_Click" />
            </StackPanel>
        </Grid>

        <TabControl x:Name="MainTabs" Grid.Row="1" Background="{StaticResource WindowBackground}" BorderBrush="{StaticResource PanelBorder}">
            <TabItem Header="Painel">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource WindowBackground}">
                    <StackPanel Margin="12,16,0,0">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="CurrentPingLabel" Text="PING ATUAL · EXTERNO" Style="{StaticResource SmallLabel}" /><TextBlock x:Name="CurrentPingText" Text="—" Style="{StaticResource MetricValue}" /><TextBlock x:Name="CurrentPingTargetText" Text="destino externo" Style="{StaticResource SmallLabel}" /></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="AveragePingLabel" Text="MÉDIA / MÍN–MÁX · EXTERNO" Style="{StaticResource SmallLabel}" /><TextBlock x:Name="AveragePingText" Text="—" Style="{StaticResource MetricValue}" /><TextBlock x:Name="RangePingText" Text="sem amostras" Style="{StaticResource SmallLabel}" /></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="JITTER" Style="{StaticResource SmallLabel}" /><TextBlock x:Name="JitterText" Text="—" Style="{StaticResource MetricValue}" /><TextBlock Text="média da diferença entre respostas" TextWrapping="Wrap" Style="{StaticResource SmallLabel}" /></StackPanel></Border>
                            <Border Grid.Column="3" Style="{StaticResource Card}"><StackPanel><TextBlock Text="PERDA ICMP" Style="{StaticResource SmallLabel}" /><TextBlock x:Name="LossText" Text="—" Style="{StaticResource MetricValue}" /><TextBlock Text="não mede perda de todos os fluxos" TextWrapping="Wrap" Style="{StaticResource SmallLabel}" /></StackPanel></Border>
                            <Border Grid.Column="4" Style="{StaticResource Card}"><StackPanel><TextBlock Text="TRÁFEGO IPv4" Style="{StaticResource SmallLabel}" /><TextBlock x:Name="SpeedText" Text="—" Style="{StaticResource MetricValue}" /><TextBlock Text="taxa passiva estimada" Style="{StaticResource SmallLabel}" /></StackPanel></Border>
                            <Border Grid.Column="5" Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><TextBlock Text="QUALIDADE ESTIMADA" Style="{StaticResource SmallLabel}" /><TextBlock x:Name="QualityText" Text="Aguardando" Style="{StaticResource MetricValue}" /><TextBlock x:Name="QualityExplanationText" Text="Faça um diagnóstico para calcular." TextWrapping="Wrap" Style="{StaticResource SmallLabel}" /></StackPanel></Border>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="Latência até o gateway e a internet" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="A linha local ajuda a separar Wi-Fi/roteador de VPN, provedor e rota externa." Style="{StaticResource SmallLabel}" Margin="0,4,0,12" />
                                    <charts:NetworkChart x:Name="PingChart" Height="220" />
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0"><TextBlock Text="● Gateway" Foreground="#5BD6C0" Margin="0,0,18,0" /><TextBlock Text="● Internet" Foreground="#84A5FF" Margin="0,0,18,0" /><TextBlock Text="● Jogo" Foreground="#F27683" /></StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Variação e atividade" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock x:Name="JitterChartDescription" Text="Jitter entre sondas externas; tráfego é leitura passiva da placa." Style="{StaticResource SmallLabel}" Margin="0,4,0,12" />
                                    <charts:NetworkChart x:Name="JitterChart" Height="220" Mode="Jitter" />
                                    <TextBlock Text="Amostras recentes • janela local, não representa SLA do jogo" Style="{StaticResource SmallLabel}" Margin="0,9,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,12">
                                <StackPanel><TextBlock Text="Enlace local" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="GatewayStatusText" Text="Gateway: —" Margin="0,8,0,4" /><TextBlock x:Name="WifiStatusText" Text="Wi-Fi: não identificado" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" /><TextBlock x:Name="DnsStatusText" Text="DNS: aguardando diagnóstico" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel><TextBlock Text="Alertas e achados" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" /><ItemsControl x:Name="FindingsList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,8"><StackPanel Orientation="Horizontal"><TextBlock Text="•" Margin="0,0,8,0" Foreground="{StaticResource Accent}" /><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Histórico e relatório">
                <Grid Margin="12,16,12,12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10"><TextBlock Text="Diagnósticos salvos neste computador" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" /><Button x:Name="ExportButton" Content="Exportar selecionado…" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" Click="ExportButton_Click" /></DockPanel>
                    <DataGrid x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Background="#101A29" Foreground="{StaticResource PrimaryText}" RowBackground="#101A29" AlternatingRowBackground="#152237" BorderBrush="{StaticResource PanelBorder}" GridLinesVisibility="Horizontal" SelectionChanged="HistoryGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding StartedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="170" />
                            <DataGridTextColumn Header="Adaptador" Binding="{Binding AdapterName}" Width="180" />
                            <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="150" />
                            <DataGridTextColumn Header="Ping médio" Binding="{Binding InternetMetrics.AverageMs, StringFormat={}{0:F1} ms}" Width="120" />
                            <DataGridTextColumn Header="Jogo médio" Binding="{Binding GameMetrics.AverageMs, StringFormat={}{0:F1} ms}" Width="110" />
                            <DataGridTextColumn Header="Jogo jitter" Binding="{Binding GameMetrics.JitterMs, StringFormat={}{0:F1} ms}" Width="110" />
                            <DataGridTextColumn Header="Jitter" Binding="{Binding InternetMetrics.JitterMs, StringFormat={}{0:F1} ms}" Width="110" />
                            <DataGridTextColumn Header="Perda" Binding="{Binding InternetMetrics.LossPercent, StringFormat={}{0:F1}%}" Width="100" />
                            <DataGridTextColumn Header="Amostras" Binding="{Binding InternetMetrics.Sent}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="Achados do diagnóstico selecionado" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,8" />
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ReportFindingsList"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" Margin="0,4,0,8" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Avançado">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource WindowBackground}">
                    <StackPanel Margin="18" MaxWidth="980" HorizontalAlignment="Left">
                        <TextBlock Text="Destinos de diagnóstico" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="O destino externo padrão é 1.1.1.1. ICMP pode ser filtrado. Informe o IP ou nome DNS do servidor do jogo para sondá-lo durante diagnóstico e monitoramento." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,7,0,16" />
                        <TextBlock Text="Um diagnóstico envia sondas ICMP ao gateway, ao destino externo e ao servidor do jogo informado; mede a resolução do sistema para example.com; testa três tamanhos de pacote IPv4 com DF e executa um tracert limitado a oito saltos. Os dados ficam locais; a consulta DNS pode ser registrada pelo resolvedor configurado." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,16" />
                        <TextBlock Text="Destino externo" Style="{StaticResource SmallLabel}" /><TextBox x:Name="ExternalTargetBox" Text="1.1.1.1" Width="330" HorizontalAlignment="Left" Margin="0,5,0,14" />
                        <TextBlock Text="Servidor do jogo (opcional)" Style="{StaticResource SmallLabel}" /><TextBox x:Name="GameTargetBox" Width="420" HorizontalAlignment="Left" Margin="0,5,0,12" />
                        <Button Content="Salvar destinos" Width="150" HorizontalAlignment="Left" Click="SaveTargetsButton_Click" />
                        <Border Style="{StaticResource Card}" Margin="0,22,0,12"><StackPanel><TextBlock Text="Parâmetros técnicos detectados" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="AdvancedDetailsText" Text="Executar diagnóstico para preencher." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,10,0,0" /></StackPanel></Border>
                        <Button x:Name="PowerQueryButton" Content="Consultar energia do adaptador (UAC)" Width="300" HorizontalAlignment="Left" Click="PowerQueryButton_Click" />
                        <TextBlock x:Name="PowerQueryResultText" Text="A consulta administrativa é somente leitura e acontece após clicar." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,18" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Escopo da otimização automática" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="O app só oferece restaurar o TCP receive-window autotuning para Normal quando encontra níveis conhecidos como restritos ou experimentais. Antes, guarda o valor atual em um backup local; ao restaurar, verifica se o valor ainda é o que o app aplicou. Essa opção pode ajudar throughput TCP e não promete reduzir ping. DNS, MTU, RSS, interrupções e economia de energia são apenas diagnosticados/recomendados quando aplicável; não recebem valores genéricos." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel></Border>
                        <TextBlock x:Name="StatusText" Text="Pronto." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" x:Name="FooterText" Text="Ping ICMP • média das diferenças sucessivas = jitter • tráfego IPv4 passivo estimado" Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,12,0,0" />
    </Grid>
</Window>
